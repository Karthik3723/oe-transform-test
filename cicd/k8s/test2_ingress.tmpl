apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: '${KUBERNETES_PREFIX}-${JENKINSPREFIX}-${CONTAINERTYPE}-${APP_ACTIVE_PROFILE}'
  namespace: '${KUBERNETES_NAMESPACE}'
  annotations:
    kubernetes.io/ingress.allow-http: "true"
    nginx.ingress.kubernetes.io/ssl-passthrough: "false"
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
    kubernetes.io/ingress.class: nginx
    nginx.ingress.kubernetes.io/proxy-connect-timeout: '300'
    nginx.ingress.kubernetes.io/proxy-read-timeout: '300'
    nginx.ingress.kubernetes.io/proxy-send-timeout: '300'
    nginx.ingress.kubernetes.io/client-max-body-size: '1g'
    nginx.ingress.kubernetes.io/proxy-body-size: '1g'
  labels:
    project: '${PROJECT_NAME}'
    branch: '${BRANCH_NAME}'
    commit: '${COMMIT_ID}'
    role: ${CONTAINERTYPE}
    environment: '${APP_ACTIVE_PROFILE}'
spec:
  rules:
    - host: ${KUBERNETES_PREFIX}-test2.${CLUSTER_DOMAIN}
      http:
        paths:
        - path: /
          pathType: Prefix
          backend:
            service:
              name: '${KUBERNETES_PREFIX}-${JENKINSPREFIX}-${CONTAINERTYPE}-${APP_ACTIVE_PROFILE}-test2'
              port:
                number: 8088
  tls:
    - hosts:
      - '${KUBERNETES_PREFIX}-test2.${CLUSTER_DOMAIN}'
---
